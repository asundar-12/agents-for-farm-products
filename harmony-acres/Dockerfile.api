# Container image for the FastAPI backend, deployed to AWS App Runner.
#
# Named Dockerfile.api (not plain Dockerfile) so it doesn't collide with the
# image AgentCore builds for the agent runtime in this same directory. Build it
# explicitly:  docker build -f Dockerfile.api -t harmony-acres-api .
#
# App Runner passes secrets (DATABASE_URL, COGNITO_*, etc.) as environment
# variables at runtime — they are NOT baked in here, same principle as deploy.sh.
FROM python:3.12-slim

WORKDIR /app

# Install deps first so Docker caches this layer when only app code changes.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the application package and the DB migration setup.
COPY app ./app
COPY alembic ./alembic
COPY alembic.ini .

# App Runner routes traffic to this port; must match apprunner health-check.
EXPOSE 8000

# One worker is fine to start; App Runner scales by running more instances.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
